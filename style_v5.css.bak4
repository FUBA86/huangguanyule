/* =========================================================================
   预览：马卡龙玻璃拟态 v5（只在这个预览页生效，不影响正式版）
   加载顺序：style.css → style_v5.css
   ========================================================================= */

/* ===== 1. 令牌：把"靛蓝科技风"换成马卡龙 ===== */
:root {
  --brand-1: #7A9AD6;
  --brand-2: #9CB7E3;
  --brand-3: #C8D9F1;
  --brand-soft: #EEF4FD;
  --brand-ink: #516C9B;

  --ink-900: #3D465F;
  --ink-700: #55607A;
  --ink-500: #76829B;
  --ink-400: #98A3B8;
  --ink-300: #CBD3E2;
  --ink-200: #E4E9F2;
  --ink-100: #F1F4FA;
  --ink-50: #FAFBFE;

  --ok: #74C2A2;      --ok-bg: #EEF9F3;
  --warn: #E7BE7E;    --warn-bg: #FDF6E8;
  --danger: #E39FAF;  --danger-bg: #FDF0F3;
  --peach: #F0B296;   --peach-bg: #FDF3EC;
  --lilac: #B3A3DD;   --lilac-bg: #F3F0FC;
  --sky: #8CB9E2;     --sky-bg: #EFF7FD;
  --gold: #C9A25F;

  --surface: rgba(255, 253, 248, .84);
  --surface-2: rgba(255, 253, 248, .66);
  --hairline: rgba(126, 146, 180, .15);
  --hairline-2: rgba(126, 146, 180, .26);

  --sh-1: 0 1px 2px rgba(96, 116, 155, .07);
  --sh-2: 0 6px 18px -10px rgba(96, 116, 155, .32);
  --sh-3: 0 14px 34px -18px rgba(96, 116, 155, .42);
  --sh-glow: 0 10px 24px -14px rgba(122, 154, 214, .72);

  --r-sm: 12px;
  --r-md: 16px;
  --r-lg: 20px;
  --r-xl: 26px;

  --bg-main: #FCFAF4;
  --text-dark: #3D465F;
  --text-light: #76829B;
  --accent-blue: #7A9AD6;
  --accent-pink: #E39FAF;
  --accent-gold: #E7BE7E;
  --border-light: #E8E4DA;
}

/* ===== 2. 背景：柔和马卡龙光晕，去掉网格纸 ===== */
body {
  background-color: #FCFAF5 !important;
  background-image:
    linear-gradient(158deg, #E9F1FD 0%, #F2F7FE 26%, #FCFAF4 62%, #FDFCF8 100%),
    radial-gradient(1100px 700px at 4% -14%, rgba(122, 154, 214, .40), transparent 60%),
    radial-gradient(900px 620px at 106% 6%, rgba(158, 190, 232, .28), transparent 62%),
    radial-gradient(760px 560px at 46% 112%, rgba(126, 196, 170, .16), transparent 62%),
    radial-gradient(620px 460px at 96% 86%, rgba(240, 178, 150, .16), transparent 64%),
    radial-gradient(560px 420px at 2% 76%, rgba(238, 215, 176, .13), transparent 66%) !important;
  background-size: auto !important;
  background-attachment: fixed !important;
}
body::before { opacity: .12 !important; }

/* ===== 3. 侧栏 ===== */
.side-brand {
  background: linear-gradient(135deg, #7E9DD8, #A6BEE6 52%, #C0B4E0) !important;
  box-shadow: 0 12px 26px -16px rgba(94, 122, 175, .8), inset 0 1px 0 rgba(255, 253, 248, .62) !important;
  border: 1px solid rgba(255, 253, 248, .58);
}
#ui-bar {
  background: linear-gradient(180deg, rgba(244, 248, 254, .92), rgba(255, 253, 247, .88)) !important;
  border-right: 1px solid rgba(122, 154, 214, .12) !important;
}
.sidebar-row { border-radius: 12px; }
#ui-bar .actor-card,
#ui-bar .actor-mini,
.actor-card, .actor-mini {
  border-radius: 16px !important;
  background: linear-gradient(158deg, rgba(240, 247, 255, .98), rgba(255, 253, 248, .94)) !important;
  border: 1px solid rgba(122, 154, 214, .22) !important;
  box-shadow: 0 6px 16px -14px rgba(96, 116, 155, .5) !important;
}
.sidebar-row:hover { background: rgba(122, 154, 214, .10) !important; }

/* ===== 4. 主卡片：玻璃 ===== */
.passage .tech-card,
#passages .tech-card,
.passage .tech-card-business,
#passages .tech-card-business {
  background: linear-gradient(156deg, rgba(255, 255, 251, .95) 10%, rgba(240, 247, 255, .93) 58%, rgba(232, 242, 254, .92)) !important;
  backdrop-filter: blur(20px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(20px) saturate(160%) !important;
  border: 1px solid rgba(255, 255, 255, .78) !important;
  border-radius: 22px !important;
  box-shadow: 0 20px 44px -30px rgba(96, 116, 155, .42), 0 0 0 1px rgba(122, 154, 214, .16) !important;
}
.passage .tech-card::before {
  height: 0 !important;
  background: none !important;
}

/* ===== 5. 页头：从深色横幅改成浅色玻璃条 ===== */
.passage .header-banner,
#passages .header-banner,
.tech-card > .header-banner {
  background: linear-gradient(116deg, rgba(224, 235, 252, .97), rgba(244, 248, 254, .95) 48%, rgba(250, 246, 251, .95)) !important;
  color: #4A5470 !important;
  border-bottom: 1px solid rgba(122, 154, 214, .20) !important;
  box-shadow: inset 0 -1px 0 rgba(255, 253, 248, .9) !important;
  padding: clamp(14px, 2.4vw, 20px) clamp(16px, 3vw, 24px) !important;
}
.passage .header-banner::after { background: none !important; }
.passage .header-banner::after {
  content: "" !important;
  position: absolute !important;
  inset: auto 0 0 0 !important;
  height: 2px !important;
  background: linear-gradient(90deg, #7A9AD6, #8CB9E2 20%, #74C2A2 44%, #E7BE7E 66%, #F0B296 82%, #E39FAF 94%, #B3A3DD) !important;
  opacity: .62 !important;
  pointer-events: none;
}
.passage .header-banner span,
.passage .header-banner b,
.passage .header-banner h1,
.passage .header-banner h2,
.passage .header-banner h3 {
  color: #2F4A7C !important;
  font-weight: 800 !important;
  letter-spacing: .02em !important;
  text-shadow: none !important;
}
.passage .header-banner > div,
.passage .header-banner p,
.passage .header-banner small,
.passage .header-banner em {
  color: #74809A !important;
  text-shadow: none !important;
}
/* 页头里的按钮：雾蓝玻璃胶囊 */
.passage .header-banner a,
.passage .header-banner .link-internal,
.passage .header-banner button {
  background: rgba(122, 154, 214, .17) !important;
  color: #4C6291 !important;
  border: 1px solid rgba(122, 154, 214, .36) !important;
  border-radius: 999px !important;
  box-shadow: none !important;
  font-weight: 700 !important;
}
.passage .header-banner a:hover {
  background: rgba(122, 154, 214, .29) !important;
  color: #3D4A66 !important;
}

/* ===== 6. 办公室：功能格 ===== */
.dashboard-grid {
  background: linear-gradient(180deg, rgba(238, 245, 255, .55), rgba(255, 253, 247, 0) 78%) !important;
  border-radius: 20px !important;
  margin: 4px 10px 8px !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 14px !important;
  padding: clamp(14px, 2.2vw, 22px) !important;
}
.btn-box {
  background: linear-gradient(160deg, rgba(255, 255, 252, .95), rgba(238, 245, 255, .86)) !important;
  border: 1px solid rgba(255, 253, 248, .96) !important;
  border-radius: 18px !important;
  box-shadow: 0 10px 26px -20px rgba(96, 116, 155, .55), inset 0 1px 0 #fff !important;
  min-width: 0 !important;
  min-height: 96px !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 4px !important;
  padding: 14px 12px !important;
  text-align: center !important;
}
.btn-box::before {
  background: radial-gradient(58% 108% at 50% 108%, rgba(122, 154, 214, .26), transparent 72%) !important;
}
.btn-box:hover {
  border-color: rgba(122, 154, 214, .46) !important;
  box-shadow: 0 16px 32px -22px rgba(96, 116, 155, .65), 0 0 0 3px rgba(122, 154, 214, .13) !important;
}
/* 六个功能格：各带一层极淡的本色底，颜色丰富但一直保持奶油感 */
.dashboard-grid > .btn-box:nth-child(1) {
  background: linear-gradient(158deg, rgba(122, 154, 214, .30), rgba(255, 254, 250, .92) 64%) !important;
  border-color: rgba(122, 154, 214, .26) !important;
}
.dashboard-grid > .btn-box:nth-child(2) {
  background: linear-gradient(158deg, rgba(116, 194, 162, .30), rgba(255, 254, 250, .92) 64%) !important;
  border-color: rgba(116, 194, 162, .26) !important;
}
.dashboard-grid > .btn-box:nth-child(3) {
  background: linear-gradient(158deg, rgba(240, 178, 150, .31), rgba(255, 254, 250, .92) 64%) !important;
  border-color: rgba(240, 178, 150, .28) !important;
}
.dashboard-grid > .btn-box:nth-child(4) {
  background: linear-gradient(158deg, rgba(238, 215, 176, .34), rgba(255, 254, 250, .92) 64%) !important;
  border-color: rgba(238, 215, 176, .30) !important;
}
.dashboard-grid > .btn-box:nth-child(5) {
  background: linear-gradient(158deg, rgba(179, 163, 221, .30), rgba(255, 254, 250, .92) 64%) !important;
  border-color: rgba(179, 163, 221, .26) !important;
}
.dashboard-grid > .btn-box:nth-child(6) {
  background: linear-gradient(158deg, rgba(140, 185, 226, .32), rgba(255, 254, 250, .92) 64%) !important;
  border-color: rgba(140, 185, 226, .28) !important;
}
/* 底部柔光常显（原来只在 hover 出现） */
.dashboard-grid > .btn-box:nth-child(-n+6)::before {
  opacity: 1 !important;
  inset: auto -25% -40% -25% !important;
  height: 120px !important;
}
.btn-box > a,
.btn-box > a.link-internal,
.btn-box > span {
  color: #414B66 !important;
  font-weight: 700 !important;
  font-size: 1.02rem !important;
  letter-spacing: .01em !important;
  height: auto !important;
  width: auto !important;
  display: block !important;
  line-height: 1.45 !important;
  text-align: center !important;
}
.btn-box > a:hover { color: #33405E !important; }
/* 去掉链接自带的虚线下划线/边框 */
.btn-box > a,
.btn-box > a:hover,
.btn-box > a:focus {
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  background: transparent !important;
  text-decoration: none !important;
}
.btn-box .btn-sub {
  color: #93A0B8 !important;
  letter-spacing: .1em !important;
  font-weight: 600 !important;
  font-size: .64rem !important;
  display: block !important;
  margin: 0 !important;
}
/* 剧情入口 / 断线卡 / 休息：统一玻璃，不用彩色边框 */
.btn-box[style*="border-color"],
.btn-box.btn-gossip {
  border-color: rgba(255, 253, 248, .96) !important;
  background: linear-gradient(160deg, rgba(255, 254, 250, .97), rgba(243, 247, 253, .84)) !important;
}
#ui-bar [style*="fef9c3"],
#ui-bar [style*="fefce8"] {
  background: linear-gradient(158deg, rgba(253, 246, 226, .96), rgba(255, 253, 248, .92)) !important;
  border-color: rgba(231, 190, 126, .40) !important;
}
.btn-box[style*="background"][style*="#fef2f2"] {
  background: linear-gradient(160deg, rgba(253, 242, 245, .96), rgba(255, 254, 250, .88)) !important;
}

/* ===== 7. 资源条：玻璃胶囊 ===== */
.status-bar {
  background: rgba(255, 253, 248, .74) !important;
  border: 1px solid rgba(255, 253, 248, .92) !important;
  border-radius: 18px !important;
  box-shadow: 0 10px 26px -22px rgba(96, 116, 155, .55) !important;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}
.status-bar > div {
  background: rgba(246, 250, 255, .96) !important;
  border: 1px solid rgba(255, 255, 255, .96) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .9) !important;
  color: #5A6881 !important;
}
.status-bar > div:nth-child(1) { background: rgba(255, 250, 241, .96) !important; }
.status-bar > div:nth-child(2) { background: rgba(255, 246, 239, .96) !important; }
.status-bar > div:nth-child(3) { background: rgba(241, 248, 255, .96) !important; }
.status-bar > div:nth-child(4) { background: rgba(248, 245, 255, .96) !important; }
.status-bar b { color: #35558C !important; }

/* ===== 8. 按钮：统一雾蓝胶囊 ===== */
.passage .btn-primary,
.passage a.btn-primary,
.res-btn-group a,
.passage a[style*="linear-gradient"],
.passage button[style*="linear-gradient"] {
  background: linear-gradient(135deg, #8199CE, #AAC3EA) !important;
  color: #fff !important;
  border: 1px solid rgba(255, 253, 248, .74) !important;
  border-radius: 999px !important;
  box-shadow: 0 10px 22px -14px rgba(104, 132, 190, .9) !important;
  text-shadow: 0 1px 1px rgba(80, 100, 145, .22);
  font-weight: 700 !important;
}
.passage a[style*="linear-gradient"]:hover,
.passage .btn-primary:hover,
.res-btn-group a:hover {
  filter: brightness(1.03);
  transform: translateY(-1px);
}
/* 纯色内联按钮（蓝/紫系）也拉回雾蓝 */
.passage a[style*="#2563eb"],
.passage a[style*="#3b82f6"],
.passage a[style*="#1d4ed8"],
.passage a[style*="#6366f1"],
.passage a[style*="#7c3aed"],
.passage a[style*="#4f46e5"],
.passage button[style*="#2563eb"],
.passage button[style*="#3b82f6"] {
  background: linear-gradient(135deg, #8199CE, #AAC3EA) !important;
  color: #fff !important;
  border-radius: 999px !important;
  border: 1px solid rgba(255, 253, 248, .74) !important;
}
.passage div[data-passage][style*="linear-gradient"] {
  background: linear-gradient(135deg, #8199CE, #AAC3EA) !important;
  color: #fff !important;
  border: 1px solid rgba(255, 255, 255, .74) !important;
  border-radius: 999px !important;
  box-shadow: 0 10px 22px -14px rgba(104, 132, 190, .9) !important;
  font-weight: 700 !important;
}
.passage .continue-row a,
.passage .btn-group a.link-internal {
  background: linear-gradient(135deg, #8199CE, #AAC3EA) !important;
  color: #fff !important;
  border-radius: 999px !important;
  box-shadow: 0 10px 22px -14px rgba(104, 132, 190, .9) !important;
  letter-spacing: .12em;
}

/* ===== 9. 二级页通用件 ===== */
/* 9.1 内联高饱和色 → 马卡龙语义色（实装时改成 class，这里先用属性选择器兜住） */
.passage [style*="color:#2563eb"],
.passage [style*="color:#1d4ed8"],
.passage [style*="color:#3b82f6"],
.passage [style*="color:#0284c7"],
.passage [style*="color:#0ea5e9"],
.passage [style*="color:#7c3aed"],
.passage [style*="color:#6366f1"] { color: #5677B8 !important; }

.passage [style*="color:#a855f7"],
.passage [style*="color:#8b5cf6"],
.passage [style*="color:#9333ea"] { color: #7C68B4 !important; }

.passage [style*="color:#ec4899"],
.passage [style*="color:#db2777"],
.passage [style*="color:#be185d"] { color: #B96A90 !important; }

.passage [style*="color:#16a34a"],
.passage [style*="color:#059669"],
.passage [style*="color:#166534"],
.passage [style*="color:#047857"] { color: #3E8A6E !important; }

.passage [style*="color:#ef4444"],
.passage [style*="color:#dc2626"],
.passage [style*="color:#b91c1c"],
.passage [style*="color:#e11d48"] { color: #BC6A82 !important; }

.passage [style*="color:#f59e0b"],
.passage [style*="color:#d97706"],
.passage [style*="color:#b45309"] { color: #A5732F !important; }

/* 9.2 内联浅色边框 → 统一玻璃边 */
.passage [style*="border:1px solid #cbd5e1"],
.passage [style*="border:1px solid #e2e8f0"] { border-color: rgba(122, 154, 214, .32) !important; }
.passage [style*="border:1px solid #93c5fd"],
.passage [style*="border:1px solid #bfdbfe"] { border-color: rgba(140, 185, 226, .5) !important; }
.passage [style*="border:1px solid #fcd34d"],
.passage [style*="border:1px solid #fde68a"],
.passage [style*="border:1px solid #fbbf24"] { border-color: rgba(231, 190, 126, .6) !important; }
.passage [style*="border:1px solid #f87171"],
.passage [style*="border:1px solid #fecaca"],
.passage [style*="border:1px solid #fca5a5"] { border-color: rgba(227, 159, 175, .55) !important; }
.passage [style*="border:1px solid #bbf7d0"],
.passage [style*="border:1px solid #86efac"] { border-color: rgba(116, 194, 162, .55) !important; }

/* 内联纯白底的小卡 → 玻璃 */
.passage [style*="background:#fff"][style*="border-radius:6px"],
.passage [style*="background:#fff"][style*="border-radius: 6px"],
.passage [style*="background:#fff"][style*="border-radius:8px"],
.passage [style*="background:#fff"][style*="border-radius: 8px"] {
  background: rgba(255, 253, 248, .8) !important;
  border-radius: 14px !important;
  box-shadow: inset 0 1px 0 #fff, 0 8px 20px -18px rgba(90, 110, 145, .65) !important;
}

/* 深浅文字统一 */
.passage [style*="color:#020617"],
.passage [style*="color:#0f172a"],
.passage [style*="color:#111827"],
.passage [style*="color:#1e40af"],
.passage [style*="color:#334155"],
.passage [style*="color:#1e293b"] { color: #414B66 !important; }
.passage [style*="color:#991b1b"],
.passage [style*="color:#9f1239"] { color: #9A5A6E !important; }
.passage [style*="color:#78350f"],
.passage [style*="color:#92400e"] { color: #8B6636 !important; }

/* 9.3 进度条填充（div，不是按钮） */
.passage div[style*="background:#2563eb"],
.passage div[style*="background: #2563eb"],
.passage div[style*="background:#3b82f6"],
.passage div[style*="background: #3b82f6"] {
  background: linear-gradient(90deg, #8FA9DE, #C3D5F0) !important;
}
.passage div[style*="background:#16a34a"],
.passage div[style*="background: #16a34a"],
.passage div[style*="background:#10b981"],
.passage div[style*="background: #10b981"] {
  background: linear-gradient(90deg, #7FC7A9, #BCE4D3) !important;
}

/* 9.3b 原生进度条（<progress>）统一成雾蓝细条 */
.passage progress {
  -webkit-appearance: none;
  appearance: none;
  width: 100% !important;
  height: 7px !important;
  border: none !important;
  border-radius: 999px !important;
  background: rgba(122, 142, 172, .14) !important;
  overflow: hidden;
  vertical-align: middle;
}
.passage progress::-webkit-progress-bar {
  background: rgba(122, 142, 172, .14) !important;
  border-radius: 999px !important;
}
.passage progress::-webkit-progress-value {
  background: linear-gradient(90deg, #7797D4, #A9C3E9) !important;
  border-radius: 999px !important;
}
.passage progress::-moz-progress-bar {
  background: #A2BBE4 !important;
  border-radius: 999px !important;
}

/* 单选/复选：系统默认蓝 → 雾蓝 */
.passage input[type="radio"],
.passage input[type="checkbox"] { accent-color: #7A9AD6 !important; }

/* 9.4 卡片本体 */
.sub-card,
.card-container > div,
.passage .res-box,
.passage .card-container {
  background: rgba(255, 253, 248, .72) !important;
  border: 1px solid rgba(255, 253, 248, .92) !important;
  border-radius: 18px !important;
  box-shadow: 0 12px 28px -24px rgba(90, 110, 145, .6) !important;
}
.sub-card:hover { border-color: rgba(122, 154, 214, .42) !important; }

/* 浅色边框的小卡：底色跟着边框色走，颜色更丰富 */
.passage [style*="border:1px solid #93c5fd"],
.passage [style*="border:1px solid #bfdbfe"] {
  background: linear-gradient(158deg, rgba(140, 185, 226, .16), rgba(255, 254, 250, .93) 70%) !important;
}
.passage [style*="border:1px solid #fbbf24"],
.passage [style*="border:1px solid #fde68a"],
.passage [style*="border:1px solid #fcd34d"] {
  background: linear-gradient(158deg, rgba(238, 215, 176, .18), rgba(255, 254, 250, .93) 70%) !important;
}
.passage [style*="border:1px solid #fca5a5"],
.passage [style*="border:1px solid #fecaca"],
.passage [style*="border:1px solid #f87171"] {
  background: linear-gradient(158deg, rgba(240, 178, 150, .18), rgba(255, 254, 250, .93) 70%) !important;
}
.passage [style*="border:1px solid #86efac"],
.passage [style*="border:1px solid #bbf7d0"] {
  background: linear-gradient(158deg, rgba(116, 194, 162, .16), rgba(255, 254, 250, .93) 70%) !important;
}

/* 小标题左侧色条 → 淡紫圆角块 */
.passage h3[style*="border-left"],
.passage .section-title {
  border-left-color: #B3A3DD !important;
  color: #414B66 !important;
}
.passage .section-title > span:first-child {
  background: #F4F1FD !important;
  border-color: rgba(179, 163, 221, .32) !important;
}

/* 进度条 */
.passage div[style*="background:#e2e8f0"],
.passage div[style*="background: #e2e8f0"],
.passage div[style*="background:#f1f5f9"] { background: rgba(122, 142, 172, .14) !important; }

/* 表格 */
.passage table, .passage th, .passage td { border-color: rgba(122, 142, 172, .18) !important; }
.passage th { background: rgba(252, 249, 242, .95) !important; color: #5A6881 !important; }

/* 输入/选择 */
.passage input, .passage select, .passage textarea {
  background: rgba(255, 253, 248, .9) !important;
  border: 1px solid rgba(122, 142, 172, .24) !important;
  border-radius: 12px !important;
  color: #46556D !important;
}

/* ===== 10. 手机适配（重点修溢出） ===== */
.passage, #passages .passage { min-width: 0 !important; }
#story-wrap { min-width: 0 !important; overflow-x: clip; }
#passage-main { min-width: 0 !important; }
#passage-main * { min-width: 0; }

@media (max-width: 860px) {
  .dashboard-grid {
  background: linear-gradient(180deg, rgba(238, 245, 255, .55), rgba(255, 253, 247, 0) 78%) !important;
  border-radius: 20px !important;
  margin: 4px 10px 8px !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
  .status-bar { flex-wrap: wrap !important; row-gap: 8px !important; }
  .status-bar > div { flex: 1 1 calc(50% - 10px); justify-content: center; }
  .passage .header-banner { flex-wrap: wrap !important; row-gap: 8px !important; }
}

@media (max-width: 620px) {
  body { font-size: 15px !important; }
  #story-wrap { padding: 12px 10px 26px !important; }
  .dashboard-grid {
  background: linear-gradient(180deg, rgba(238, 245, 255, .55), rgba(255, 253, 247, 0) 78%) !important;
  border-radius: 20px !important;
  margin: 4px 10px 8px !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 10px !important; padding: 12px !important; }
  .btn-box { min-height: 88px !important; border-radius: 16px !important; padding: 10px 8px !important; }
  .btn-box a { font-size: .95rem !important; }
  .btn-box .btn-sub { font-size: .56rem !important; letter-spacing: .06em !important; }
  .status-bar { margin: 12px 12px 4px !important; padding: 10px !important; }
  .status-bar > div { font-size: .85rem; padding: 4px 8px !important; }
  .passage .tech-card, #passages .tech-card { border-radius: 16px !important; }
  .passage .header-banner { border-radius: 0 !important; padding: 12px 14px !important; }
  .passage .header-banner span { font-size: 1rem !important; }
  .passage .header-banner a, .passage .header-banner .link-internal {
    padding: 5px 10px !important; font-size: .74rem !important;
  }
}

@media (max-width: 430px) {
  .dashboard-grid {
  background: linear-gradient(180deg, rgba(238, 245, 255, .55), rgba(255, 253, 247, 0) 78%) !important;
  border-radius: 20px !important;
  margin: 4px 10px 8px !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
  .btn-box { min-height: 82px !important; }
  .btn-box a { font-size: .9rem !important; }
  .passage .btn-group, .passage .res-btn-group { gap: 8px !important; }
  .passage .btn-group a, .passage .btn-group button { flex: 1 1 100% !important; }
}

/* ===== 11. 功能格内链接：彻底清掉胶囊样式（覆盖 .link-internal） ===== */
.passage .btn-box .link-internal,
.passage .btn-box .link-internal:hover,
.passage .btn-box a {
  background: none !important;
  background-image: none !important;
  box-shadow: none !important;
  border: 0 !important;
  outline: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 0 !important;
  text-decoration: none !important;
  transform: none !important;
}

@media (max-width: 620px) {
  .passage .btn-box .btn-sub {
    white-space: normal !important;
    word-break: break-word !important;
    font-size: .55rem !important;
    letter-spacing: .02em !important;
    line-height: 1.3 !important;
    margin-top: 2px !important;
  }
  .passage .btn-box { padding: 12px 8px !important; }
}

/* ===== 12. 小屏按钮与选项行 ===== */
@media (max-width: 620px) {
  .passage button,
  .passage .link-internal.btn-macro,
  .passage a[style*="gradient"] {
    padding: 8px 12px !important;
    font-size: .82rem !important;
    white-space: nowrap !important;
    border-radius: 999px !important;
    line-height: 1.5 !important;
  }
  .passage label { display: inline-flex !important; align-items: center; gap: 4px; margin: 0 8px 6px 0; }
  .passage input[type="radio"] { flex: 0 0 auto; }
}


/* ===== 13. 深色横幅 → 奶油玻璃横幅（资源库存条等） ===== */
.passage [style*="background:#1e293b"],
.passage [style*="background: #1e293b"],
.passage [style*="background:#0f172a"],
.passage [style*="background: #0f172a"],
.passage [style*="background:#111827"] {
  background: linear-gradient(118deg, rgba(228, 238, 253, .96), rgba(255, 251, 243, .95) 62%, rgba(248, 243, 253, .95)) !important;
  color: #35558C !important;
  border: 1px solid rgba(122, 154, 214, .24) !important;
  box-shadow: 0 12px 26px -22px rgba(96, 116, 155, .55), inset 0 1px 0 #fff !important;
  text-shadow: none !important;
}
.passage [style*="background:#1e293b"] span,
.passage [style*="background:#0f172a"] span,
.passage [style*="background:#111827"] span { text-shadow: none !important; }
/* 深底上的荧光字 → 奶油底上的同色系深字 */
.passage [style*="color:#fbbf24"] { color: #A9762A !important; }
.passage [style*="color:#e879f9"] { color: #8B6BB8 !important; }
.passage [style*="color:#c084fc"] { color: #8B6BB8 !important; }
.passage [style*="color:#60a5fa"] { color: #4C74B4 !important; }
.passage [style*="color:#38bdf8"] { color: #3F86AE !important; }
.passage [style*="color:#94a3b8"] { color: #7E8A9E !important; }
.passage [style*="color:#e2e8f0"] { color: #5E6880 !important; }
.passage [style*="color:#f8fafc"] { color: #35558C !important; }


/* ===== 14. 实心色块标签 → 淡彩底 + 同色深字 ===== */
.passage span[style*="background:#16a34a"],
.passage span[style*="background: #16a34a"],
.passage span[style*="background:#10b981"],
.passage span[style*="background:#059669"] {
  background: rgba(116, 194, 162, .20) !important;
  color: #2E7A60 !important;
  border: 1px solid rgba(116, 194, 162, .42) !important;
}
.passage span[style*="background:#2563eb"],
.passage span[style*="background: #2563eb"],
.passage span[style*="background:#3b82f6"],
.passage span[style*="background:#6366f1"] {
  background: rgba(122, 154, 214, .20) !important;
  color: #32538C !important;
  border: 1px solid rgba(122, 154, 214, .42) !important;
}
.passage span[style*="background:#dc2626"],
.passage span[style*="background:#ef4444"],
.passage span[style*="background:#e11d48"] {
  background: rgba(227, 159, 175, .22) !important;
  color: #A2516A !important;
  border: 1px solid rgba(227, 159, 175, .46) !important;
}
.passage span[style*="background:#f59e0b"],
.passage span[style*="background:#d97706"] {
  background: rgba(231, 190, 126, .24) !important;
  color: #8E6122 !important;
  border: 1px solid rgba(231, 190, 126, .48) !important;
}
.passage span[style*="background:#7c3aed"],
.passage span[style*="background:#8b5cf6"] {
  background: rgba(179, 163, 221, .24) !important;
  color: #6B57A0 !important;
  border: 1px solid rgba(179, 163, 221, .48) !important;
}


/* ===== 15. 饼图与提示条 ===== */
/* 内联 conic-gradient 的饼图：降饱和 + 提亮，靠拢马卡龙 */
.passage div[style*="conic-gradient"] {
  filter: saturate(.58) brightness(1.06) !important;
  box-shadow: 0 8px 18px -12px rgba(96, 116, 155, .7) !important;
}
/* 灰提示条 → 淡蓝奶油条 */
.passage [style*="background:#f1f5f9"],
.passage [style*="background: #f1f5f9"],
.passage [style*="background:#f8fafc"] {
  background: linear-gradient(118deg, rgba(236, 244, 254, .9), rgba(255, 252, 245, .9)) !important;
  border: 1px solid rgba(122, 154, 214, .16) !important;
  border-radius: 12px !important;
}


/* ===== 16. 高频内联色 → 奶油马卡龙文字色 ===== */
/* 次级灰蓝 */
.passage [style*="color:#64748b"] { color: #7C88A3 !important; }
.passage [style*="color:#94a3b8"] { color: #98A4BA !important; }
.passage [style*="color:#475569"] { color: #5C6880 !important; }
.passage [style*="color:#334155"] { color: #4A5670 !important; }
.passage [style*="color:#1e293b"] { color: #3E4A66 !important; }
.passage [style*="color:#0f172a"] { color: #36415C !important; }
.passage [style*="color:#334151"] { color: #474A5F !important; }
.passage [style*="color:#93a0b5"] { color: #8B97AD !important; }
/* 蓝 */
.passage [style*="color:#2563eb"] { color: #4E74B0 !important; }
.passage [style*="color:#1d4ed8"] { color: #4468A6 !important; }
.passage [style*="color:#3b82f6"] { color: #557CB8 !important; }
.passage [style*="color:#1e40af"] { color: #35568F !important; }
.passage [style*="color:#0284c7"] { color: #3C7FA6 !important; }
.passage [style*="color:#0ea5e9"] { color: #4289B4 !important; }
/* 绿 */
.passage [style*="color:#059669"] { color: #3B876C !important; }
.passage [style*="color:#10b981"],
.passage [style*="color:#16a34a"] { color: #458F73 !important; }
.passage [style*="color:#166534"] { color: #2F7256 !important; }
.passage [style*="color:#047857"] { color: #357C63 !important; }
/* 红 */
.passage [style*="color:#ef4444"] { color: #BC6479 !important; }
.passage [style*="color:#dc2626"] { color: #B25C72 !important; }
.passage [style*="color:#b91c1c"] { color: #9E4A60 !important; }
.passage [style*="color:#e11d48"] { color: #B25C78 !important; }
.passage [style*="color:#be185d"] { color: #A55476 !important; }
.passage [style*="color:#db2777"] { color: #AE587C !important; }
.passage [style*="color:#9f1239"] { color: #93485F !important; }
.passage [style*="color:#991b1b"] { color: #8E4256 !important; }
/* 橙黄 */
.passage [style*="color:#d97706"] { color: #9E6A24 !important; }
.passage [style*="color:#f59e0b"] { color: #A8762C !important; }
.passage [style*="color:#b45309"] { color: #915F22 !important; }
.passage [style*="color:#c2410c"] { color: #A75F32 !important; }
.passage [style*="color:#ea580c"] { color: #A86236 !important; }
.passage [style*="color:#92400e"] { color: #8B6636 !important; }
/* 紫 */
.passage [style*="color:#7c3aed"] { color: #7059AC !important; }
.passage [style*="color:#8b5cf6"] { color: #7A63B4 !important; }
.passage [style*="color:#9333ea"] { color: #7C63B0 !important; }

/* ===== 17. 粗色条（border-left 4px）→ 柔化同色系 ===== */
.passage [style*="solid #dc2626"],
.passage [style*="solid #ef4444"],
.passage [style*="solid #b91c1c"],
.passage [style*="solid #e11d48"] { border-color: rgba(214, 132, 152, .62) !important; }
.passage [style*="solid #2563eb"],
.passage [style*="solid #3b82f6"],
.passage [style*="solid #1d4ed8"],
.passage [style*="solid #0ea5e9"],
.passage [style*="solid #6366f1"] { border-color: rgba(122, 154, 214, .62) !important; }
.passage [style*="solid #16a34a"],
.passage [style*="solid #059669"],
.passage [style*="solid #10b981"],
.passage [style*="solid #166534"] { border-color: rgba(116, 194, 162, .62) !important; }
.passage [style*="solid #f59e0b"],
.passage [style*="solid #d97706"],
.passage [style*="solid #fbbf24"],
.passage [style*="solid #fcd34d"] { border-color: rgba(231, 190, 126, .68) !important; }
.passage [style*="solid #7c3aed"],
.passage [style*="solid #8b5cf6"],
.passage [style*="solid #9333ea"] { border-color: rgba(179, 163, 221, .65) !important; }


/* ===== 18. 剧情模式 / 月结页：同步奶油蓝 ===== */
body.story-mode {
  background: linear-gradient(158deg, #E9F1FD 0%, #F3F8FE 30%, #FBF7EF 68%, #FDFAF3 100%) !important;
  background-attachment: fixed !important;
}
body.story-mode::before {
  background: radial-gradient(circle, rgba(122, 154, 214, .26) 0%, rgba(122, 154, 214, 0) 70%) !important;
}
body.story-mode::after {
  background: radial-gradient(circle, rgba(240, 178, 150, .20) 0%, rgba(240, 178, 150, 0) 70%) !important;
}
.story-card {
  background: linear-gradient(158deg, rgba(255, 255, 252, .78), rgba(240, 247, 255, .70)) !important;
  border: 1px solid rgba(255, 255, 255, .85) !important;
  box-shadow: 0 18px 40px -28px rgba(96, 116, 155, .55), inset 0 1px 0 rgba(255, 255, 255, .9) !important;
}
.story-header {
  background: linear-gradient(180deg, rgba(255, 255, 255, .55), rgba(255, 255, 255, 0)) !important;
  border-bottom: 1px solid rgba(122, 154, 214, .14) !important;
}
.story-kicker { color: #A3B0C6 !important; }
.story-title { color: #33507F !important; }
.story-body, .story-card p, .story-card div { color: #4A556E; }
.story-divider { background: linear-gradient(90deg, transparent, rgba(122, 154, 214, .35), transparent) !important; }

/* 月结卡 */
.nm-card {
  background: linear-gradient(158deg, rgba(255, 255, 252, .92), rgba(242, 248, 255, .84)) !important;
  border: 1px solid rgba(255, 255, 255, .92) !important;
  box-shadow: 0 10px 26px -22px rgba(96, 116, 155, .55) !important;
}
.nm-card.quiet {
  background: rgba(255, 255, 252, .62) !important;
}
.nm-head h1, .nm-head .nm-title { color: #33507F !important; }


/* ===== 19. 极浅语义底：降低纯度，统一到"奶油白 + 少许本色" ===== */
.passage [style*="background:#fef2f2"],
.passage [style*="background:#fff1f2"],
.passage [style*="background:#fff0f5"],
.passage [style*="background:#fbf0f3"],
.passage [style*="background:#fff5f5"] {
  background: linear-gradient(156deg, rgba(255, 247, 247, .92), rgba(246, 250, 255, .9)) !important;
  border-color: rgba(227, 159, 175, .30) !important;
}
.passage [style*="background:#f0fdf4"],
.passage [style*="background:#ecfdf5"],
.passage [style*="background:#f0fdfa"] {
  background: linear-gradient(156deg, rgba(243, 252, 247, .92), rgba(246, 250, 255, .9)) !important;
  border-color: rgba(116, 194, 162, .32) !important;
}
.passage [style*="background:#eff6ff"],
.passage [style*="background:#f0f9ff"],
.passage [style*="background:#eef2ff"] {
  background: linear-gradient(156deg, rgba(240, 246, 255, .94), rgba(255, 253, 248, .9)) !important;
  border-color: rgba(122, 154, 214, .32) !important;
}
.passage [style*="background:#fff7ed"],
.passage [style*="background:#fffbeb"],
.passage [style*="background:#fefce8"] {
  background: linear-gradient(156deg, rgba(255, 249, 238, .94), rgba(248, 250, 255, .9)) !important;
  border-color: rgba(231, 190, 126, .36) !important;
}
.passage [style*="background:#faf5ff"],
.passage [style*="background:#f5f3ff"] {
  background: linear-gradient(156deg, rgba(248, 245, 255, .94), rgba(246, 250, 255, .9)) !important;
  border-color: rgba(179, 163, 221, .34) !important;
}

/* 补充：亮绿/亮青文字 */
.passage [style*="color:#22c55e"],
.passage [style*="color:#4ade80"],
.passage [style*="color:#34d399"] { color: #4E9077 !important; }
.passage [style*="color:#06b6d4"],
.passage [style*="color:#0891b2"] { color: #43849E !important; }
/* 补充：亮红方块图标柔化 */
.passage [style*="background:#dc2626"],
.passage [style*="background:#b91c1c"] {
  background: linear-gradient(150deg, #D08096, #BE6279) !important;
}

/* =========================================================================
   v6 · 布局与按钮重构（只改外观，不动任何逻辑）
   ========================================================================= */

/* ===== 24. 标题：去掉小英文，标题居中对齐 ===== */
/* 24.1 侧栏品牌只留中文 */
.side-brand small { display: none !important; }
.side-brand { justify-content: center !important; text-align: center !important; }

/* 24.2 页头：标题居中，右侧数据贴右浮起 */
.passage .header-banner {
  position: relative !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  min-height: 64px;
  gap: 12px;
}
.passage .header-banner > div,
.passage .header-banner > span { text-align: center; }
.passage .header-banner > div { font-weight: 900; letter-spacing: .02em; }
.passage .header-banner > *:last-child:not(:only-child) {
  position: absolute !important;
  right: clamp(14px, 2.2vw, 22px) !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  text-align: right !important;
}

/* ===== 25. 按钮底层：统一「奶油玻璃药丸」 ===== */
.passage a.link-internal,
.passage a.link-internal:visited {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 40px;
  padding: 9px 18px !important;
  margin: 3px 6px 3px 0 !important;
  border-radius: 999px !important;
  background: linear-gradient(158deg, #FFFFFF 0%, #F5F9FE 52%, #EAF2FD 100%) !important;
  border: 1px solid rgba(136, 160, 200, .34) !important;
  color: #33456A !important;
  font-weight: 700 !important;
  font-size: .93rem !important;
  line-height: 1.2 !important;
  letter-spacing: .01em;
  text-decoration: none !important;
  text-shadow: none !important;
  box-shadow: inset 0 1px 0 #FFFFFF, 0 6px 14px -11px rgba(90, 110, 150, .75) !important;
  transition: background .18s ease, color .18s ease, border-color .18s ease,
              box-shadow .2s ease, transform .16s ease;
  vertical-align: middle;
}
.passage a.link-internal:hover,
.passage a.link-internal:focus-visible {
  background: linear-gradient(158deg, #FFFFFF 0%, #DEEBFC 58%, #D0E2FA 100%) !important;
  border-color: rgba(122, 154, 214, .60) !important;
  color: #1C3055 !important;
  transform: translateY(-1px);
  box-shadow: inset 0 1px 0 #FFFFFF, 0 12px 22px -14px rgba(96, 124, 178, .9),
              0 0 0 3px rgba(122, 154, 214, .12) !important;
}
.passage a.link-internal:active { transform: translateY(0) scale(.985); }
.passage a.link-internal:focus-visible { outline: none !important; }

/* 25.1 例外：容器型链接不套药丸（外观交给容器） */
.passage .btn-box > a,
.passage .btn-box a,
.passage .tab-btn a,
.passage .tab-btn a:hover,
.passage .res-btn-group a,
.passage .res-btn-group a:hover,
.passage .header-banner a,
.passage .header-banner a:hover,
.passage .nm-next a,
.passage .continue-row a,
.passage .story-nav a {
  background: none !important;
  border: 0 !important;
  box-shadow: none !important;
  margin: 0 !important;
  min-height: 0;
  padding: 0 !important;
  transform: none;
}

/* 25.2 主行动按钮：实心雾蓝，只留给「推进」类操作 */
.passage .continue-row a,
.passage .nm-next a,
.passage .btn-primary,
.passage a[style*="linear-gradient"],
.passage button[style*="linear-gradient"],
.passage div[data-passage][style*="linear-gradient"] {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 12px 32px !important;
  border-radius: 999px !important;
  background: linear-gradient(135deg, #6B88C6 0%, #8CAADB 100%) !important;
  border: 1px solid rgba(255, 255, 255, .78) !important;
  color: #FFFFFF !important;
  font-weight: 800 !important;
  font-size: .98rem !important;
  letter-spacing: .08em;
  text-decoration: none !important;
  text-shadow: 0 1px 1px rgba(74, 96, 138, .28) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .55),
              0 12px 24px -14px rgba(96, 124, 178, .95) !important;
  transition: transform .18s ease, filter .18s ease, box-shadow .2s ease;
}
.passage .continue-row a:hover,
.passage .nm-next a:hover,
.passage .btn-primary:hover,
.passage a[style*="linear-gradient"]:hover {
  transform: translateY(-2px);
  filter: brightness(1.04);
  color: #FFFFFF !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .6),
              0 18px 30px -16px rgba(96, 124, 178, 1) !important;
}

/* 25.3 页头小按钮（说明书 / 返回） */
.passage .header-banner a,
.passage .header-banner a.link-internal {
  display: inline-flex !important;
  align-items: center;
  min-height: 32px;
  padding: 6px 14px !important;
  border-radius: 999px !important;
  background: rgba(255, 255, 255, .82) !important;
  border: 1px solid rgba(122, 154, 214, .34) !important;
  color: #35507C !important;
  font-size: .8rem !important;
  font-weight: 700 !important;
  box-shadow: inset 0 1px 0 #fff, 0 4px 10px -9px rgba(90, 110, 150, .8) !important;
}
.passage .header-banner a:hover {
  background: linear-gradient(158deg, #FFFFFF, #DCEBFC) !important;
  color: #1C3055 !important;
}

/* ===== 26. 办公室：一整张卡 + 有厚度的功能格 ===== */
#passage-main:has(> .dashboard-grid) {
  background: linear-gradient(158deg, rgba(255, 255, 252, .97) 0%, rgba(242, 248, 255, .95) 54%, rgba(233, 242, 254, .93) 100%) !important;
  border: 1px solid rgba(255, 255, 255, .92) !important;
  border-radius: 26px !important;
  box-shadow: 0 26px 54px -36px rgba(96, 116, 155, .55), 0 0 0 1px rgba(122, 154, 214, .14) !important;
  overflow: hidden;
  padding: 0 0 4px !important;
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
}
#passage-main:has(> .dashboard-grid) > .header-banner {
  border-radius: 0 !important;
  border-bottom: 1px solid rgba(122, 154, 214, .14) !important;
  padding: 20px clamp(18px, 2.6vw, 26px) !important;
}
#passage-main:has(> .dashboard-grid) > .status-bar {
  margin: 16px clamp(16px, 2.4vw, 22px) 4px !important;
}
#passage-main:has(> .dashboard-grid) > .dashboard-grid {
  background: none !important;
  margin: 0 !important;
  padding: clamp(14px, 2vw, 18px) clamp(16px, 2.4vw, 22px) 6px !important;
}
/* 开发者通道：收成页脚小字 */
#passage-main:has(> .dashboard-grid) > div[style*="margin-top: 50px"] {
  margin: 10px 0 0 !important;
  padding: 12px 0 14px !important;
  border-top: 1px solid rgba(122, 154, 214, .14);
  opacity: 1 !important;
}
#passage-main:has(> .dashboard-grid) > div[style*="margin-top: 50px"] a {
  background: none !important;
  border: 0 !important;
  box-shadow: none !important;
  color: #93A0B6 !important;
  font-size: .78rem !important;
  font-weight: 600 !important;
  min-height: 0 !important;
  padding: 4px 10px !important;
  letter-spacing: .06em;
}
#passage-main:has(> .dashboard-grid) > div[style*="margin-top: 50px"] a:hover {
  color: #5B6B8C !important;
  background: rgba(122, 154, 214, .08) !important;
  transform: none;
  box-shadow: none !important;
}

/* 功能格：本色渐变 → 奶白，玻璃厚度 */
.dashboard-grid > .btn-box {
  border-radius: 20px !important;
  min-height: 128px !important;
  padding: 18px 14px !important;
  box-shadow: inset 0 1px 0 #FFFFFF,
              inset 0 -20px 26px -24px rgba(96, 116, 155, .40),
              0 14px 26px -24px rgba(90, 110, 150, .70) !important;
  transition: transform .2s cubic-bezier(.22, 1, .36, 1), box-shadow .24s ease, border-color .22s ease;
}
.dashboard-grid > .btn-box:hover {
  transform: translateY(-3px);
  border-color: rgba(255, 255, 255, .98) !important;
  box-shadow: inset 0 1px 0 #FFFFFF,
              inset 0 -20px 26px -22px rgba(96, 116, 155, .45),
              0 22px 34px -26px rgba(90, 110, 150, .85),
              0 0 0 3px rgba(122, 154, 214, .10) !important;
}
.dashboard-grid > .btn-box:active { transform: translateY(-1px) scale(.995); }
.dashboard-grid > .btn-box > a,
.dashboard-grid > .btn-box > span {
  font-size: 1.06rem !important;
  letter-spacing: .04em !important;
  color: #2C3852 !important;
}
/* 休息：只有它保留红调，做「本月结束」的分界 */
#passage-main .btn-box[style*="#fef2f2"] {
  background: linear-gradient(158deg, rgba(240, 178, 172, .30), rgba(255, 253, 250, .94) 66%) !important;
  min-height: 74px !important;
}

/* ===== 27. 艺人切换：分段控件 ===== */
.passage .tab-grid {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 6px !important;
  padding: 6px !important;
  background: rgba(255, 255, 255, .62) !important;
  border: 1px solid rgba(255, 255, 255, .92) !important;
  border-radius: 999px !important;
  box-shadow: inset 0 1px 0 #FFFFFF, 0 8px 18px -18px rgba(90, 110, 150, .7) !important;
}
.passage .tab-btn {
  flex: 1 1 0 !important;
  min-width: 96px !important;
  min-height: 42px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 6px !important;
  background: transparent !important;
  border: 0 !important;
  border-radius: 999px !important;
  box-shadow: none !important;
  transition: background .18s ease, box-shadow .2s ease;
}
.passage .tab-btn:hover { background: rgba(255, 255, 255, .9) !important; }
.passage .tab-btn a,
.passage .tab-btn a.link-internal {
  display: block !important;
  width: 100% !important;
  min-height: 0;
  padding: 8px 6px !important;
  margin: 0 !important;
  color: #4B5873 !important;
  font-size: .92rem !important;
  font-weight: 700 !important;
  letter-spacing: .02em;
  text-align: center !important;
}
.passage .tab-btn[style*="#e0f2fe"],
.passage .tab-btn[style*="#f0fdf4"] {
  background: linear-gradient(158deg, #FFFFFF, #EAF3FF) !important;
  box-shadow: inset 0 0 0 1px rgba(122, 154, 214, .42),
              0 6px 12px -10px rgba(90, 110, 150, .9) !important;
}
.passage .tab-btn[style*="#e0f2fe"] a,
.passage .tab-btn[style*="#f0fdf4"] a { color: #22375C !important; font-weight: 800 !important; }

/* ===== 28. S / A / B / C：做成可点的键帽 ===== */
.passage .res-btn-group { gap: 9px !important; margin-top: 10px !important; }
.passage .res-btn-group a,
.passage .res-btn-group span {
  width: 48px !important;
  min-width: 48px !important;
  height: 44px !important;
  border-radius: 14px !important;
  font-size: .98rem !important;
  font-weight: 800 !important;
  letter-spacing: .06em;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
}
.passage .res-btn-group a {
  background: linear-gradient(160deg, #FFFFFF 0%, #F3F8FE 100%) !important;
  border: 1px solid rgba(136, 160, 200, .40) !important;
  color: #36507E !important;
  box-shadow: inset 0 1px 0 #FFFFFF, 0 5px 10px -8px rgba(90, 110, 150, .85) !important;
}
.passage .res-btn-group a:hover {
  background: linear-gradient(135deg, #6B88C6, #A3C1E9) !important;
  color: #FFFFFF !important;
  border-color: rgba(255, 255, 255, .8) !important;
  transform: translateY(-2px);
  box-shadow: 0 12px 20px -12px rgba(96, 124, 178, .95) !important;
}
.passage .res-btn-group span {
  background: rgba(246, 249, 253, .7) !important;
  border: 1px dashed rgba(140, 160, 190, .38) !important;
  color: #B3BDCE !important;
  box-shadow: none !important;
  cursor: not-allowed;
}

/* ===== 29. PC 布局：加宽、减少空档 ===== */
@media (min-width: 981px) {
  .passage, #passages .passage { max-width: 1180px !important; }

  /* 办公室：一整屏的节奏 */
  #passage-main:has(> .dashboard-grid) {
    min-height: calc(100dvh - 58px);
    display: flex !important;
    flex-direction: column !important;
  }
  #passage-main:has(> .dashboard-grid) > .dashboard-grid {
    flex: 1 1 auto;
    grid-template-rows: repeat(2, minmax(118px, 1fr));
    align-content: stretch;
  }

  /* 月结页 / 剧情页也放开一点，不要两边空一大片 */
  .nm-page { max-width: 920px !important; }
  .deep-hub { max-width: 920px !important; }
  body.story-mode .story-card { max-width: 760px !important; }
  body.story-mode .tech-card { max-width: 780px !important; }
}

/* ===== 30. 手机端：按钮与格子收紧但不挤 ===== */
@media (max-width: 620px) {
  .passage a.link-internal {
    min-height: 38px;
    padding: 8px 14px !important;
    font-size: .86rem !important;
    margin: 2px 4px 2px 0 !important;
  }
  .passage .header-banner > *:last-child:not(:only-child) {
    position: static !important;
    transform: none !important;
    text-align: center !important;
  }
  .passage .header-banner {
    flex-wrap: wrap !important;
    row-gap: 8px !important;
    min-height: 0;
    padding: 14px 16px !important;
  }
  #passage-main:has(> .dashboard-grid) > .header-banner { padding: 14px 16px !important; }
  .dashboard-grid > .btn-box { min-height: 92px !important; padding: 12px 8px !important; border-radius: 18px !important; }
  .dashboard-grid > .btn-box > a, .dashboard-grid > .btn-box > span { font-size: .95rem !important; }
  .passage .tab-btn { min-width: 0 !important; flex: 1 1 40% !important; min-height: 38px !important; }
  .passage .tab-btn a { font-size: .84rem !important; padding: 7px 4px !important; }
  .passage .res-btn-group a, .passage .res-btn-group span { width: 44px !important; min-width: 44px !important; height: 40px !important; }
  .passage .continue-row a, .passage .nm-next a, .passage .btn-primary { padding: 11px 24px !important; font-size: .92rem !important; }
}

/* ===== 31. 办公室功能格的新结构：图标 + 文字 + 箭头 ===== */
.passage .btn-box > a.tile,
.passage .btn-box > span.tile {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: flex-start !important;
  gap: 14px !important;
  width: 100% !important;
  min-height: 100% !important;
  padding: 0 clamp(4px, 1vw, 10px) !important;
  text-align: left !important;
  background: none !important;
  border: 0 !important;
  box-shadow: none !important;
  transform: none !important;
}
.tile-ico {
  flex: 0 0 auto;
  width: 46px;
  height: 46px;
  border-radius: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  line-height: 1;
  background: linear-gradient(160deg, #FFFFFF 8%, rgba(255, 255, 255, .52) 100%);
  border: 1px solid rgba(255, 255, 255, .92);
  box-shadow: inset 0 1px 0 #FFFFFF, 0 6px 14px -10px rgba(90, 110, 150, .85);
}
.tile-txt {
  display: block;
  font-size: 1.04rem !important;
  font-weight: 700 !important;
  letter-spacing: .05em !important;
  color: #2C3852 !important;
  line-height: 1.35 !important;
  text-align: left !important;
}
.tile-sub {
  display: block;
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: .02em;
  color: #7E8CA3;
  margin-top: 3px;
}
.tile-go {
  margin-left: auto;
  font-size: 1.4rem;
  line-height: 1;
  color: #93A6C6;
  opacity: .5;
  transition: transform .2s ease, opacity .2s ease;
}
.btn-box:hover .tile-go { opacity: .95; transform: translateX(3px); }
.tile-badge {
  margin-left: 2px;
  padding: 2px 9px;
  border-radius: 999px;
  background: rgba(240, 178, 150, .28);
  color: #A05B38;
  font-size: .7rem;
  font-weight: 800;
  white-space: nowrap;
}

/* 休息 / 剧情入口 / 断线：三种语义色，仍保持奶油玻璃 */
#passage-main .btn-box.btn-rest {
  background: linear-gradient(150deg, rgba(236, 176, 170, .32), rgba(255, 253, 250, .95) 72%) !important;
  min-height: 84px !important;
}
#passage-main .btn-box.btn-rest .tile-txt { color: #8C4E58 !important; }
#passage-main .btn-box.btn-rest .tile-ico {
  background: linear-gradient(160deg, #FFFFFF 8%, rgba(253, 236, 234, .72) 100%);
  box-shadow: inset 0 1px 0 #FFFFFF, 0 6px 14px -10px rgba(180, 120, 120, .75);
}
#passage-main .btn-box.btn-story {
  background: linear-gradient(150deg, rgba(140, 185, 226, .26), rgba(255, 255, 252, .95) 74%) !important;
  min-height: 88px !important;
}
#passage-main .btn-box.btn-dead {
  opacity: .72 !important;
  background: linear-gradient(150deg, rgba(186, 195, 210, .24), rgba(255, 255, 252, .93) 74%) !important;
}
#passage-main .btn-box.btn-dead .tile-txt { color: #78849A !important; }
#passage-main .btn-box.btn-dead .tile-ico { background: rgba(255, 255, 255, .7); }

@media (max-width: 620px) {
  .tile-ico { width: 38px; height: 38px; border-radius: 12px; font-size: 1.15rem; }
  .tile-txt { font-size: .92rem !important; }
  .tile-go { font-size: 1.1rem; }
  .passage .btn-box > a.tile, .passage .btn-box > span.tile { gap: 9px !important; padding: 0 2px !important; }
  .tile-sub { font-size: .66rem; }
  .tile-badge { display: none; }
}

/* ===== 32. PC 宽屏下功能格改为「大图标 + 居中文字」的方块 ===== */
@media (min-width: 981px) {
  .passage .btn-box > a.tile,
  .passage .btn-box > span.tile {
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 12px !important;
    text-align: center !important;
  }
  .tile-txt { text-align: center !important; font-size: 1.1rem !important; }
  .tile-ico { width: 54px; height: 54px; border-radius: 18px; font-size: 1.6rem; }
  .tile-go { display: none; }
  #passage-main .btn-box.btn-rest > a.tile,
  #passage-main .btn-box.btn-story > a.tile,
  #passage-main .btn-box.btn-story > span.tile,
  #passage-main .btn-box.btn-dead > span.tile {
    flex-direction: row !important;
    justify-content: flex-start !important;
    gap: 16px !important;
    padding-left: 12px !important;
    text-align: left !important;
  }
  #passage-main .btn-box.btn-rest .tile-txt,
  #passage-main .btn-box.btn-story .tile-txt { text-align: left !important; }
  #passage-main .btn-box.btn-rest .tile-go,
  #passage-main .btn-box.btn-story .tile-go { display: block; }
}

/* ===== 33. 宏按钮（<<button>>）统一成同一套按钮 ===== */
.passage button.btn-macro,
button.link-internal.btn-macro {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-width: 132px;
  min-height: 42px;
  padding: 10px 22px !important;
  border-radius: 999px !important;
  background: linear-gradient(135deg, #6B88C6 0%, #8CAADB 100%) !important;
  border: 1px solid rgba(255, 255, 255, .76) !important;
  color: #FFFFFF !important;
  font-family: inherit;
  font-size: .92rem !important;
  font-weight: 800 !important;
  letter-spacing: .04em;
  cursor: pointer;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .5),
              0 10px 20px -14px rgba(96, 124, 178, .95) !important;
  transition: transform .18s ease, filter .18s ease, box-shadow .2s ease;
}
.passage button.btn-macro:hover {
  transform: translateY(-2px);
  filter: brightness(1.04);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .55),
              0 16px 26px -16px rgba(96, 124, 178, 1) !important;
}
.passage button.btn-macro.btn-secondary,
.passage button.btn-macro.btn-return {
  background: linear-gradient(158deg, #FFFFFF, #EEF4FD) !important;
  color: #4A5876 !important;
  border: 1px solid rgba(136, 160, 200, .38) !important;
  box-shadow: inset 0 1px 0 #fff, 0 6px 14px -12px rgba(90, 110, 150, .8) !important;
  text-shadow: none !important;
}
.passage button.btn-macro.btn-secondary:hover,
.passage button.btn-macro.btn-return:hover {
  background: linear-gradient(158deg, #FFFFFF, #DEEBFC) !important;
  color: #1C3055 !important;
  border-color: rgba(122, 154, 214, .6) !important;
}
/* 行内小按钮（价格行 / 监控面板） */
#passage-main [style*="display:flex"] > button.btn-macro,
#passage-main [style*="display: flex"] > button.btn-macro {
  min-width: 0 !important;
  padding: 8px 16px !important;
  font-size: .82rem !important;
  min-height: 36px;
}

/* ===== 34. 粉丝运营：四张操作卡 ===== */
.passage .fan-acts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 6px;
}
.passage .fan-act {
  display: flex;
  flex-direction: column;
  padding: 14px 16px;
  border-radius: 18px;
  background: linear-gradient(158deg, rgba(255, 255, 255, .96), rgba(243, 248, 255, .92)) !important;
  border: 1px solid rgba(255, 255, 255, .94) !important;
  box-shadow: inset 0 1px 0 #FFFFFF, 0 12px 24px -22px rgba(90, 110, 150, .85) !important;
}
.passage .fan-act-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.passage .fan-act-name {
  font-size: .96rem;
  font-weight: 800;
  color: #33415C;
  letter-spacing: .02em;
}
.passage .fan-act-cost {
  flex: 0 0 auto;
  padding: 3px 10px;
  border-radius: 999px;
  background: rgba(122, 154, 214, .13);
  color: #5A7196;
  font-size: .72rem;
  font-weight: 800;
  white-space: nowrap;
}
.passage .fan-act-btns {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  flex-wrap: wrap;
}
.passage .fan-act-btns a {
  flex: 1 1 0 !important;
  min-width: 0;
  margin: 0 !important;
  padding: 9px 10px !important;
  font-size: .86rem !important;
  white-space: nowrap;
}
.passage .fan-act-warn {
  margin-top: 10px;
  font-size: .7rem;
  line-height: 1.5;
  color: #B08A3E;
}

/* ===== 35. 艺人切换轨道：让「分段控件」看得出来 ===== */
.passage .tab-grid {
  background: linear-gradient(158deg, rgba(231, 240, 252, .95), rgba(246, 250, 255, .92)) !important;
  border: 1px solid rgba(255, 255, 255, .9) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .9),
              inset 0 -1px 2px rgba(122, 154, 214, .10),
              0 10px 22px -24px rgba(90, 110, 150, .9) !important;
}
@media (max-width: 620px) {
  .passage .fan-acts { grid-template-columns: 1fr; }
  .passage .fan-act { padding: 12px 13px; }
}

/* ===== 36. 公关操作行：一条行内就看清「做什么 / 花多少 / 代价」 ===== */
.passage .pr-acts { display: grid; gap: 9px; margin-top: 12px; }
.passage .pr-acts-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.passage .pr-acts-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.passage .pr-act {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 13px;
  border-radius: 14px;
  background: linear-gradient(158deg, rgba(255, 255, 255, .96), rgba(244, 249, 255, .9)) !important;
  border: 1px solid rgba(255, 255, 255, .94) !important;
  box-shadow: inset 0 1px 0 #FFFFFF, 0 8px 18px -20px rgba(90, 110, 150, .9) !important;
  transition: border-color .18s, box-shadow .2s, transform .16s, background .18s;
}
.passage .pr-act:hover {
  border-color: rgba(122, 154, 214, .52) !important;
  background: linear-gradient(158deg, #FFFFFF, #E9F2FE) !important;
  box-shadow: inset 0 1px 0 #FFFFFF, 0 12px 22px -18px rgba(90, 110, 150, .95) !important;
  transform: translateY(-1px);
}
.passage .pr-act a,
.passage .pr-act a.link-internal {
  flex: 1 1 auto;
  justify-content: flex-start !important;
  background: none !important;
  border: 0 !important;
  box-shadow: none !important;
  padding: 0 !important;
  margin: 0 !important;
  min-height: 0 !important;
  color: #33415C !important;
  font-size: .9rem !important;
  font-weight: 700 !important;
  text-align: left;
  transform: none !important;
}
.passage .pr-act a::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 14px;
}
.passage .pr-act-name {
  flex: 1 1 auto;
  font-size: .9rem;
  font-weight: 700;
  color: #8A94A6;
}
.passage .pr-act-cost {
  font-size: .72rem;
  font-weight: 700;
  color: #6F7D96;
  white-space: nowrap;
}
.passage .pr-act-tag {
  font-size: .68rem;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(122, 154, 214, .12);
  color: #5A7196;
  white-space: nowrap;
}
.passage .pr-act-tag.good { background: rgba(116, 194, 162, .22); color: #2E7A60; }
.passage .pr-act-tag.warn { background: rgba(240, 178, 150, .26); color: #9E5A3B; }
.passage .pr-act.is-out { opacity: .62; }
.passage .pr-label {
  margin: 15px 0 0;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: .08em;
  color: #7C8AA2;
}
@media (max-width: 720px) {
  .passage .pr-acts-2, .passage .pr-acts-3 { grid-template-columns: 1fr; }
}

/* ===== 37. 居中独立链接（返回 / 确认）→ 主按钮；页脚链接保持低调 ===== */
#passage-main div[style*="text-align:center"] > a.link-internal,
#passage-main div[style*="text-align: center"] > a.link-internal,
#passage-main p[style*="text-align:center"] > a.link-internal {
  background: linear-gradient(135deg, #6B88C6 0%, #8CAADB 100%) !important;
  color: #FFFFFF !important;
  border: 1px solid rgba(255, 255, 255, .74) !important;
  border-radius: 999px !important;
  padding: 11px 28px !important;
  margin-top: 6px !important;
  min-height: 44px;
  font-weight: 800 !important;
  letter-spacing: .06em;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .5),
              0 12px 24px -14px rgba(96, 124, 178, .95) !important;
}
#passage-main div[style*="text-align:center"] > a.link-internal:hover,
#passage-main div[style*="text-align: center"] > a.link-internal:hover {
  color: #FFFFFF !important;
  transform: translateY(-2px);
  filter: brightness(1.04);
}
/* 办公室的开发者通道：压回页脚小字 */
#passage-main:has(> .dashboard-grid) > div[style*="margin-top: 50px"] > a.link-internal {
  background: none !important;
  color: #93A0B6 !important;
  border: 0 !important;
  box-shadow: none !important;
  padding: 4px 10px !important;
  min-height: 0 !important;
  font-size: .78rem !important;
  font-weight: 600 !important;
  letter-spacing: .06em;
  margin: 0 !important;
}
#passage-main:has(> .dashboard-grid) > div[style*="margin-top: 50px"] > a.link-internal:hover {
  background: rgba(122, 154, 214, .08) !important;
  color: #5B6B8C !important;
  transform: none;
}

/* ===== 38. 单选项：做成可点的胶囊 ===== */
.passage label:has(> input[type="radio"]) {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 15px;
  border-radius: 999px;
  background: rgba(255, 255, 255, .92);
  border: 1px solid rgba(136, 160, 200, .32);
  box-shadow: inset 0 1px 0 #FFFFFF, 0 4px 10px -12px rgba(90, 110, 150, .9);
  font-weight: 700;
  font-size: .86rem;
  color: #3C4C6C;
  cursor: pointer;
  margin: 0 8px 6px 0;
  transition: background .18s, color .18s, border-color .18s;
}
.passage label:has(> input[type="radio"]):hover { border-color: rgba(122, 154, 214, .55); }
.passage label:has(> input[type="radio"]:checked) {
  background: linear-gradient(135deg, #6B88C6, #8CAADB);
  color: #FFFFFF;
  border-color: rgba(255, 255, 255, .7);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .45), 0 8px 16px -12px rgba(96, 124, 178, .95);
}
.passage label:has(> input[type="radio"]:checked) input { accent-color: #FFFFFF; }
#war-actor-selector { background: none !important; border: 0 !important; padding: 0 !important; }

/* 公关操作行：名称再实一点 */
.passage .pr-act a, .passage .pr-act a.link-internal { font-size: .94rem !important; }

/* 主按钮用更深的雾蓝，白字才看得清 */
.passage .continue-row a,
.passage .nm-next a,
.passage .btn-primary,
.passage a[style*="linear-gradient"],
.passage button.btn-macro:not(.btn-secondary):not(.btn-return),
#passage-main div[style*="text-align:center"] > a.link-internal {
  background: linear-gradient(135deg, #6B88C6 0%, #8CAADB 100%) !important;
}
.passage label:has(> input[type="radio"]) input { display: none !important; }
.passage label:has(> input[type="radio"]) { padding-left: 16px; padding-right: 16px; }

/* ===== 39. 页头：右侧数据改成标题下的一行小字（避免长数据挤标题） ===== */
.passage .header-banner:has(> span:last-child:not(:only-child)) {
  flex-direction: column !important;
  gap: 5px !important;
  min-height: 0 !important;
  padding: 16px 22px 14px !important;
}
.passage .header-banner > span:last-child:not(:only-child) {
  position: static !important;
  transform: none !important;
  font-size: .74rem !important;
  font-weight: 600 !important;
  letter-spacing: .04em !important;
  color: #6B7791 !important;
  opacity: 1 !important;
}
/* 月结页头也居中，和别的页面一致 */
.nm-head { justify-content: center !important; text-align: center !important; }
.nm-head-left { justify-content: center !important; }

/* ===== 40. 手机端收尾：副标题隐藏、粉丝页上下排、切换轨道圆角 ===== */
@media (max-width: 620px) {
  .tile-sub { display: none !important; }
  .passage .tab-grid { border-radius: 20px !important; padding: 6px !important; }
  .passage .tab-btn { flex: 1 1 42% !important; }

  /* 粉丝页：饼图与数据卡改为上下排，数据卡两列不折行 */
  .passage div[style*="align-items:flex-start"][style*="gap:20px"] {
    flex-direction: column !important;
    align-items: center !important;
    gap: 14px !important;
  }
  .passage div[style*="grid-template-columns: 1fr 1fr"] {
    width: 100% !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 6px !important;
  }
  .passage [style*="background:#FAFCFF"] {
    padding: 6px 9px !important;
    gap: 8px !important;
  }
  .passage [style*="background:#FAFCFF"] span {
    white-space: nowrap !important;
    font-size: .78em !important;
    line-height: 1.35 !important;
  }
  .passage div[style*="conic-gradient"] {
    width: 118px !important;
    height: 118px !important;
  }
  body.story-mode .choice-item a,
  body.story-mode .choice-area > a.link-internal {
    padding: 13px 18px;
    font-size: 14.5px;
    letter-spacing: .08em;
  }
}

/* ===== 41. 片约卡：深蓝头 → 奶油玻璃 ===== */
.passage .biz-header {
  background: linear-gradient(116deg, rgba(226, 238, 254, .96), rgba(247, 243, 252, .95)) !important;
  color: #3B4E72 !important;
  border-bottom: 1px solid rgba(122, 154, 214, .18);
}
.passage .biz-header-title {
  color: #2F4570 !important;
  font-weight: 800;
  text-transform: none !important;
  letter-spacing: .04em !important;
  font-size: .95rem !important;
}
.passage .biz-header .badge { background: #FFFFFF !important; color: #4A6A9E !important; border: 1px solid rgba(122,154,214,.3); }
.passage .biz-card { max-width: 720px !important; }
